int main() {
    int sum = 0;
    int i = 0;
    while (i < 40) {
        int j = 0;
        while (j < 40) {
            int k = 0;
            while (k < 40) {
                sum = sum + i * j + k;
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return sum % 256;
}
