int main() {
    int sum = 0;
    int i = 0;
    while (i < 200) {
        int a = i * 3 + 5;
        int b = i * 2 + 7;
        int c = (a + b) * (a - b);
        int d = (a + b) + (a - b);
        int e = (a + b) - (a - b);

        if (a > b) {
            sum = sum + c;
        } else {
            sum = sum + d + e;
        }

        int f = a * a;
        int g = b * b;
        sum = sum + f - g;
        i = i + 1;
    }
    return sum % 256;
}
